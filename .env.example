# Feishu self-built app. Leave empty when running the local demo.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Local technical-preview persistence.
LOG_AGENT_DB_PATH=./data/logagent.db

# Optional worker identity and polling settings.
LOG_AGENT_WORKER_ID=worker-local
LOG_AGENT_POLL_INTERVAL=1s
LOG_AGENT_LEASE_DURATION=30s

# Optional M3 governance-change catalog. Empty means cause enrichment is
# explicitly unavailable while the M2 report still succeeds.
LOG_AGENT_CHANGE_CATALOG=

# Feishu delivery worker. The delivery lease must be longer than send timeout.
LOG_AGENT_DELIVERY_WORKER_ID=feishu-delivery-local
LOG_AGENT_DELIVERY_POLL_INTERVAL=500ms
LOG_AGENT_DELIVERY_LEASE_DURATION=30s
LOG_AGENT_DELIVERY_SEND_TIMEOUT=8s
LOG_AGENT_DELIVERY_MAX_ATTEMPTS=5
LOG_AGENT_DELIVERY_RETRY_BASE=2s

# Query source. The default mock mode never contacts Alibaba Cloud.
LOG_AGENT_SLS_MODE=mock
LOG_AGENT_SLS_CATALOG=./config/sls-resources.json

# Real mode credentials: static accepts a RAM AccessKey or STS credentials.
# Prefer a short-lived STS token or set ecs_ram_role with an attached ECS role.
LOG_AGENT_SLS_CREDENTIAL_MODE=static
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
LOG_AGENT_SLS_ECS_RAM_ROLE_NAME=

# Fixed-template query guardrails. Increase INGESTION_GRACE to match the
# measured collector-to-index delay of the pilot LogStore.
LOG_AGENT_SLS_REQUEST_TIMEOUT=15s
LOG_AGENT_SLS_QUERY_TIMEOUT=45s
LOG_AGENT_SLS_MAX_WINDOW=2h
LOG_AGENT_SLS_INGESTION_GRACE=10s
LOG_AGENT_SLS_MAX_ROWS=12
LOG_AGENT_SLS_MAX_API_CALLS=4
LOG_AGENT_SLS_MAX_PROCESSED_BYTES=268435456
LOG_AGENT_SLS_MAX_CONCURRENT=2
LOG_AGENT_SLS_SCHEMA_TTL=5m

# SQLite technical-preview tenant quota and cost-proxy circuit. These are
# per trusted app/tenant and fixed UTC window; they are not global billing.
LOG_AGENT_TENANT_QUOTA_WINDOW=1h
LOG_AGENT_TENANT_QUOTA_MAX_OBSERVATIONS=100
LOG_AGENT_TENANT_QUOTA_MAX_API_CALLS=400
LOG_AGENT_TENANT_QUOTA_MAX_PROCESSED_BYTES=8589934592
LOG_AGENT_TENANT_QUOTA_RESERVED_BYTES=268435456

# Evidence-bound report summary. Default mock is deterministic and performs no
# network calls. The local fixed-window request/Token ledger is not a provider
# bill or production-global quota. Enable volcengine only after model, prompt,
# cost and retention approval; inject ARK_API_KEY from a secret manager.
LOG_AGENT_LLM_MODE=mock
ARK_API_KEY=
LOG_AGENT_ARK_MODEL=
LOG_AGENT_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LOG_AGENT_LLM_TIMEOUT=12s
LOG_AGENT_LLM_QUOTA_WINDOW=1h
LOG_AGENT_LLM_QUOTA_MAX_REQUESTS=100
LOG_AGENT_LLM_QUOTA_MAX_TOKENS=409600
LOG_AGENT_LLM_QUOTA_RESERVED_TOKENS=4096

# Identity used only by the explicit sls-smoke diagnostic command.
LOG_AGENT_SMOKE_APP_ID=
LOG_AGENT_SMOKE_TENANT_KEY=
LOG_AGENT_SMOKE_USER_ID=
